# talktoy Pi settings. Edit BRAIN_URL to your Mac's IP (System Settings > Wi-Fi > Details).
BRAIN_URL=http://Admins-MacBook-Air.local:8700
TOY_ID=dikkey

# ALSA devices. Run `arecord -l` and `aplay -l`; e.g. plughw:1,0 for a USB sound card.
MIC_DEVICE=default
SPEAKER_DEVICE=default

BUTTON_PIN=17
LED_PIN=27
WEB_PORT=8080
MAX_SECONDS=15
BRAIN_TIMEOUT=320

# First "thinking" line language (en/hi/as); after that it follows the child.
TOY_LANG=en
FILLER_EVERY=8
